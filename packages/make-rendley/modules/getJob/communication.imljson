{
	"url": "{{if(parameters.host = 'agent', '/agent/jobs/' + parameters.jobId, '/jobs/' + parameters.jobId)}}",
	"method": "GET",
	"response": {
		"output": {
			"job_id": "{{ifempty(body.data.job_id, body.data.id)}}",
			"status": "{{body.data.status}}",
			"type": "{{body.data.type}}",
			"is_complete": "{{contains(add([], 'completed', 'failed', 'canceled', 'cancelled', 'waiting_input'), body.data.status)}}",
			"project_id": "{{ifempty(body.data.project_id, ifempty(get(body.data, 'output.project_id'), body.data.source_id))}}",
			"thread_id": "{{body.data.thread_id}}",
			"url": "{{get(body.data, 'output.url')}}",
			"url_expires_at": "{{get(body.data, 'output.url_expires_at')}}",
			"media_id": "{{ifempty(get(body.data, 'output.media_id'), get(parseJSON(body.data.result_data), 'media_id'))}}",
			"file_hash": "{{ifempty(get(body.data, 'output.file_hash'), get(parseJSON(body.data.result_data), 'file_hash'))}}",
			"mime_type": "{{ifempty(get(body.data, 'output.mime_type'), get(parseJSON(body.data.result_data), 'mime_type'))}}",
			"size": "{{ifempty(get(body.data, 'output.size'), get(parseJSON(body.data.result_data), 'size'))}}",
			"duration": "{{ifempty(get(body.data, 'output.duration'), get(parseJSON(body.data.result_data), 'duration'))}}",
			"result_data": "{{parseJSON(body.data.result_data)}}",
			"last_message": "{{body.data.last_message}}",
			"question": "{{get(body.data, 'interrupt.summary')}}",
			"error": "{{body.data.error}}"
		}
	}
}
