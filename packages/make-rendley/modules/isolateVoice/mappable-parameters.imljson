[
	{
		"name": "projectId",
		"type": "select",
		"label": "Project ID",
		"required": true,
		"options": {
			"store": "rpc://listProjects"
		},
		"help": "The Rendley project that will own the generated media. Pick one, or map a project ID from 'Create Project' / 'List Projects'."
	},
	{
		"name": "source",
		"type": "text",
		"label": "Source File (File Hash)",
		"required": true,
		"validate": {
			"pattern": "^(?!https?://)"
		},
		"help": "The file_hash of a media item already in the project's library. Public URLs are NOT supported for this action — Rendley prices it from the file's duration, which is only known for library media. Upload the file to the project first, then map its file_hash here."
	},
	{
		"name": "modelId",
		"type": "text",
		"label": "Model ID",
		"required": false,
		"advanced": true,
		"help": "Optional. A specific model ID for this action (catalog at GET /v1/ai/tools). Leave empty for the recommended default."
	}
]
