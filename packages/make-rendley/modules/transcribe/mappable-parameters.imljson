[
	{
		"name": "projectId",
		"type": "select",
		"label": "Project ID",
		"required": false,
		"options": {
			"store": "rpc://listProjects"
		},
		"help": "Optional. Leave empty to save the result to the workspace library. Pick a project to save into it instead."
	},
	{
		"name": "workspaceId",
		"type": "select",
		"label": "Workspace",
		"required": false,
		"options": {
			"store": "rpc://listWorkspaces"
		},
		"help": "Only used when Project ID is empty. Leave empty for your first workspace."
	},
	{
		"name": "source",
		"type": "text",
		"label": "Source file (URL, media ID or file hash)",
		"required": true,
		"help": "Public URL of the audio/video file to transcribe, or the media_id or file_hash of a file already in the project's library (see 'Upload media from URL')."
	},
	{
		"name": "startTime",
		"type": "number",
		"label": "Start time (seconds)",
		"required": false,
		"advanced": true,
		"help": "Optional. Transcribe from this time in seconds. Defaults to the beginning of the file."
	},
	{
		"name": "endTime",
		"type": "number",
		"label": "End time (seconds)",
		"required": false,
		"advanced": true,
		"help": "Optional. Transcribe up to this time in seconds. Defaults to the full file duration."
	},
	{
		"name": "modelId",
		"type": "text",
		"label": "Model ID",
		"required": false,
		"advanced": true,
		"help": "Optional. A specific model ID for this action (catalog at GET /v1/ai/models). Leave empty for the recommended default."
	}
]
