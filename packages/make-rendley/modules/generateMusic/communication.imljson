{
	"url": "/ai/generate-music",
	"method": "POST",
	"body": {
		"project_id": "{{parameters.projectId}}",
		"model_id": "{{parameters.modelId}}",
		"params": {
			"prompt": "{{parameters.prompt}}",
			"duration_seconds": "{{parameters.duration}}"
		}
	},
	"response": {
		"output": {
			"job_id": "{{body.data.job_id}}"
		}
	}
}
