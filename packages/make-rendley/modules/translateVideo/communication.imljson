{
	"url": "/ai/video-translate",
	"method": "POST",
	"body": {
		"project_id": "{{parameters.projectId}}",
		"workspace_id": "{{if(parameters.projectId, undefined, parameters.workspaceId)}}",
		"model_id": "{{parameters.modelId}}",
		"params": {
			"media": "{{parameters.source}}",
			"output_language": "{{parameters.outputLanguage}}"
		}
	},
	"response": {
		"output": {
			"job_id": "{{body.data.job_id}}"
		}
	}
}
