[
	{
		"name": "projectId",
		"type": "text",
		"label": "Project ID",
		"required": true,
		"help": "The Rendley project ID to render. Typically the project_id returned by 'AI Video Agent' / 'Get Job Status' or 'Create Project'."
	},
	{
		"name": "codec",
		"type": "select",
		"label": "Codec",
		"required": false,
