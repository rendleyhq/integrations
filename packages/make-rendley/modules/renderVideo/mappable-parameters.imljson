				"label": "720p",
				"value": "720p"
			},
			{
				"label": "1080p",
				"value": "1080p"
			},
			{
				"label": "4K",
				"value": "4K"
			}
		]
	},
	{
		"name": "quality",
		"type": "select",
		"label": "Quality",
