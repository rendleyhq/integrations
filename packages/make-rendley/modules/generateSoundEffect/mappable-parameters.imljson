[
	{
		"name": "projectId",
		"type": "select",
		"label": "Project ID",
		"required": true,
		"options": {
			"store": "rpc://listProjects"
		},
		"help": "The Rendley project that will own the generated media. Pick one, or map a project ID from 'Create Project' / 'List Projects'."
	},
	{
		"name": "prompt",
		"type": "text",
		"label": "Prompt",
		"required": true,
		"help": "A description of the sound effect (e.g. 'whoosh transition', 'dramatic impact hit', 'gentle rain ambience')."
	},
	{
		"name": "duration",
		"type": "number",
		"label": "Duration (Seconds)",
		"required": false,
		"help": "Optional. Length in seconds, from 0.5 to 22. Defaults to 5."
	},
	{
		"name": "modelId",
		"type": "text",
		"label": "Model ID",
		"required": false,
		"advanced": true,
		"help": "Optional. A specific model ID for this action (catalog at GET /v1/ai/tools). Leave empty for the recommended default."
	}
]
