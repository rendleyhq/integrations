[
	{
		"name": "workspaceId",
		"type": "text",
		"label": "Workspace ID",
		"required": false,
		"help": "Optional. Filter projects by workspace. Use 'List Workspaces' to look up available IDs."
	},
	{
		"name": "limit",
		"type": "uinteger",
		"label": "Limit",
		"required": false,
		"default": 10,
		"help": "Maximum number of projects to return. Note: the Rendley /projects endpoint does not support cursor pagination, so this only caps the number of items emitted from the returned set."
	}
]
