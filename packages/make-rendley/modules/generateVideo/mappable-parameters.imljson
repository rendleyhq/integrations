[
	{
		"name": "projectId",
		"type": "select",
		"label": "Project ID",
		"required": false,
		"options": {
			"store": "rpc://listProjects"
		},
		"help": "Optional. Leave empty to save the result to the workspace library. Pick a project to save into it instead."
	},
	{
		"name": "workspaceId",
		"type": "select",
		"label": "Workspace",
		"required": false,
		"options": {
			"store": "rpc://listWorkspaces"
		},
		"help": "Only used when Project ID is empty. Leave empty for your first workspace."
	},
	{
		"name": "prompt",
		"type": "text",
		"label": "Prompt",
		"required": true,
		"help": "A text description of the video you want to generate."
	},
	{
		"name": "startImageUrl",
		"type": "url",
		"label": "Start Image URL",
		"required": false,
		"help": "Optional. An image to use as the video's first frame (image-to-video)."
	},
	{
		"name": "duration",
		"type": "select",
		"label": "Duration (Seconds)",
		"required": false,
		"default": 5,
		"options": [
			{
				"label": "5 seconds",
				"value": 5
			},
			{
				"label": "10 seconds",
				"value": 10
			}
		],
		"help": "Optional. Clip length in seconds (supported by the default model)."
	},
	{
		"name": "modelId",
		"type": "text",
		"label": "Model ID",
		"required": false,
		"advanced": true,
		"help": "Optional. A specific model ID for this action (catalog at GET /v1/ai/tools). Leave empty for the recommended default."
	}
]
