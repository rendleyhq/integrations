{
	"url": "https://api.rendley.com/v1{{parameters.url}}",
	"method": "{{parameters.method}}",
	"qs": "{{toCollection(parameters.query, 'key', 'value')}}",
	"headers": "{{toCollection(parameters.headers, 'key', 'value')}}",
	"body": "{{parameters.body}}",
	"response": {
		"output": {
			"statusCode": "{{statusCode}}",
			"headers": "{{headers}}",
			"body": "{{body}}"
		}
	}
}
