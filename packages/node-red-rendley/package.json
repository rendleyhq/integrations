{
  "name": "@rendley/node-red-rendley",
  "version": "1.0.0",
  "description": "Node-RED nodes for Rendley: AI video editing and generation. Prompt-to-video with the Rendley AI agent, text to speech, transcription, dubbing, lip sync, image, video and music generation, and MP4 rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rendleyhq/integrations.git",
    "directory": "packages/node-red-rendley"
  },
  "homepage": "https://rendley.com",
  "author": {
    "name": "Rendley",
    "email": "support@rendley.com"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "rendley",
    "ai-video",
    "ai-video-editor",
    "video-generation",
    "text-to-video",
    "prompt-to-video",
    "video-editing",
    "text-to-speech",
    "transcription",
    "video-dubbing",
    "lip-sync",
    "image-generation",
    "mp4-export",
    "video-automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "nodes",
    "icons",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "rendley-config": "nodes/rendley-config.js",
      "rendley": "nodes/rendley.js"
    }
  },
  "scripts": {
    "build:client": "esbuild ../rendley-client/src/rendley.ts --bundle --platform=node --target=node20 --format=cjs --outfile=nodes/lib/rendley.js --log-level=warning",
    "test": "node --test test/rendley.test.js",
    "test:live": "node --test test/rendley.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4"
  }
}
