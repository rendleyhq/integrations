              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "description": "The job identifier to follow with Get job.",
                      "x-ms-summary": "Job ID"
                    }
                  },
                  "description": "The job.",
                  "x-ms-summary": "Job"
                }
              }
            }
          }
        }
      }
