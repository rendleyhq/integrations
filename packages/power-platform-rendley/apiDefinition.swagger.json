    "/ai/{action}": {
      "post": {
        "operationId": "RunAiAction",
        "summary": "Run AI action",
        "description": "Starts an AI action such as text to speech, image or video generation, transcription or dubbing. Returns a job identifier to follow with Get job.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "type": "string",
            "enum": [
              "transcribe",
              "text-to-speech",
              "video-translate",
              "lipsync",
              "voice-isolation",
              "voice-changer",
              "remove-video-background",
              "remove-image-background",
              "upscale-image",
              "generate-image",
              "generate-video",
              "generate-music",
              "generate-sound-effect"
            ],
            "description": "The AI action to run.",
            "x-ms-summary": "Action",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The action request.",
            "schema": {
              "type": "object",
              "required": [
                "project_id",
                "params"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "description": "The project the media is stored in.",
                  "x-ms-summary": "Project",
                  "x-ms-dynamic-values": {
                    "operationId": "ListProjects",
                    "value-path": "id",
                    "value-title": "name",
                    "value-collection": "data"
                  }
                },
                "model_id": {
                  "type": "string",
                  "description": "An optional model for this action, for example kling-v2.6. Leave empty for the default model.",
                  "x-ms-summary": "Model ID",
                  "x-ms-visibility": "advanced"
                },
                "params": {
                  "type": "object",
                  "description": "The model parameters as JSON. File inputs go in media as a public URL, media ID or file hash. Lip sync uses video_media and audio_media. Prompts go in prompt.",
                  "x-ms-summary": "Parameters",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded.",
