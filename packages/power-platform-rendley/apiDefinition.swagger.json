              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "media_id": {
                      "type": "string",
                      "description": "The media identifier, usable as the source of AI actions.",
                      "x-ms-summary": "Media ID"
                    },
                    "file_hash": {
                      "type": "string",
                      "description": "The file hash, also usable as the source of AI actions.",
                      "x-ms-summary": "File Hash"
                    },
                    "storage_url": {
                      "type": "string",
