{
  "name": "rendley-integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Rendley integrations for n8n, Zapier, Make and Apify. Each package is versioned, released and published independently.",
  "license": "MIT",
  "author": {
    "name": "Rendley",
    "email": "support@rendley.com"
  },
  "homepage": "https://rendley.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rendleyhq/integrations.git"
  },
  "bugs": {
    "url": "https://github.com/rendleyhq/integrations/issues"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build:client --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "packages/n8n-nodes-rendley/dist/credentials/RendleyApi.credentials.js"
    ],
    "nodes": [
      "packages/n8n-nodes-rendley/dist/nodes/Rendley/Rendley.node.js"
    ]
  }
}
